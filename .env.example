# Environment Configuration
DEBUG=true
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_ACCOUNT_ID=your_account_id_here

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=food-agent-app
S3_BUCKET_NAME=food-agent-app-uploads

# Database Configuration
DATABASE_URL=postgresql://food_user:food_password@localhost: 5432/food_agent_db
REDIS_URL=redis://localhost:6379/0

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500

# ODA Supermarket Configuration
ODA_API_KEY=your_oda_api_key_here

# Security Configuration
SECRET_KEY=your_secret_key_change_this_in_production
JWT_SECRET=your_jwt_secret_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Feature Flags
FEATURE_IMAGE_PROCESSING=true
FEATURE_RECIPE_GENERATION=true
FEATURE_NUTRITIONAL_ANALYSIS=true
FEATURE_VOICE_SUPPORT=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
